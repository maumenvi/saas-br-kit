generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id
  email       String   @unique
  displayName String?  @map("display_name")
  status      String
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  credentials         UserCredentials?
  federatedIdentities FederatedIdentity[]
  passwordResetTokens PasswordResetToken[]
  subscriptions       Subscription[]
  memberships         Membership[]

  @@map("actors")
}

model FederatedIdentity {
  id         String   @id
  userId     String   @map("user_id")
  providerId String   @map("provider_id")
  issuer     String
  subject    String
  email      String?
  createdAt  DateTime @map("created_at")
  updatedAt  DateTime @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([issuer, subject])
  @@unique([userId, issuer])
  @@index([userId])
  @@map("federated_identities")
}

model UserCredentials {
  userId       String   @id @map("user_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  status       String
  createdAt    DateTime @map("created_at")
  updatedAt    DateTime @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("actor_credentials")
}

model PasswordResetToken {
  id         String    @id
  userId     String    @map("user_id")
  secretHash String    @unique @map("secret_hash")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @map("created_at")
  consumedAt DateTime? @map("consumed_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Organization {
  id          String   @id
  ownerUserId String   @map("owner_user_id")
  name        String
  status      String
  subdomain   String?  @unique
  url         String?  @unique
  roleConfig  Json?    @map("role_config")
  metadata    Json?
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  subscriptions Subscription[]
  billingEvents BillingEvent[]
  auditEvents   AuditEvent[]
  webhookEvents WebhookEvent[]
  customers     Customer[]
  memberships   Membership[]
  plans         Plan[]

  @@map("organizations")
}

model Membership {
  id              String   @id
  organizationId  String   @map("organization_id")
  userId          String   @map("user_id")
  role            String
  status          String
  invitedByUserId String?  @map("invited_by_user_id")
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("memberships")
}

model Customer {
  id             String   @id
  organizationId String   @map("organization_id")
  name           String
  email          String?
  document       String?
  status         String
  metadata       Json?
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  subscriptions Subscription[]

  @@index([organizationId, status])
  @@map("customers")
}

model Plan {
  id             String   @id
  organizationId String   @map("organization_id")
  code           String
  name           String
  amountCents    Int      @map("amount_cents")
  currency       String
  interval       String
  features       Json
  status         String
  metadata       Json?
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  subscriptions Subscription[]
  billingEvents BillingEvent[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("plans")
}

model Subscription {
  id                     String    @id
  organizationId         String    @map("organization_id")
  userId                 String?   @map("user_id")
  customerId             String?   @map("customer_id")
  planId                 String    @map("plan_id")
  status                 String
  provider               String
  providerConnectionId   String    @map("provider_connection_id")
  providerCustomerId     String?   @map("provider_customer_id")
  providerSubscriptionId String?   @map("provider_subscription_id")
  currentPeriodStart     DateTime? @map("current_period_start")
  currentPeriodEnd       DateTime? @map("current_period_end")
  metadata               Json?
  createdAt              DateTime  @map("created_at")
  updatedAt              DateTime  @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  plan          Plan           @relation(fields: [planId], references: [id])
  billingEvents BillingEvent[]

  @@index([organizationId, status])
  @@index([userId])
  @@index([customerId])
  @@index([provider, providerSubscriptionId])
  @@map("subscriptions")
}

model BillingEvent {
  id             String   @id
  type           String
  occurredAt     DateTime @map("occurred_at")
  organizationId String?  @map("organization_id")
  planId         String?  @map("plan_id")
  subscriptionId String?  @map("subscription_id")
  metadata       Json?

  organization Organization? @relation(fields: [organizationId], references: [id])
  plan         Plan?         @relation(fields: [planId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([organizationId, occurredAt])
  @@map("billing_events")
}

model AuditEvent {
  id             String   @id
  type           String
  occurredAt     DateTime @map("occurred_at")
  requestId      String?  @map("request_id")
  actorType      String?  @map("actor_type")
  actorId        String?  @map("actor_id")
  organizationId String?  @map("organization_id")
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json?

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, occurredAt])
  @@map("audit_events")
}

model WebhookEvent {
  id                   String    @id
  provider             String
  providerEventId      String    @map("provider_event_id")
  eventName            String    @map("event_name")
  status               String
  rawPayload           Json      @map("raw_payload")
  receivedAt           DateTime  @map("received_at")
  updatedAt            DateTime  @map("updated_at")
  processingAttempts   Int       @map("processing_attempts")
  organizationId       String?   @map("organization_id")
  providerConnectionId String?   @map("provider_connection_id")
  providerAccountId    String?   @map("provider_account_id")
  processedAt          DateTime? @map("processed_at")
  failedAt             DateTime? @map("failed_at")
  unknownAt            DateTime? @map("unknown_at")
  lastErrorCode        String?   @map("last_error_code")
  analysisReason       String?   @map("analysis_reason")
  metadata             Json?

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}
